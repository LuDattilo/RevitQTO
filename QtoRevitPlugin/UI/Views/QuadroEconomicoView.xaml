<UserControl x:Class="QtoRevitPlugin.UI.Views.QuadroEconomicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QtoRevitPlugin.UI.ViewModels">
    <UserControl.DataContext>
        <vm:QuadroEconomicoViewModel/>
    </UserControl.DataContext>

    <Grid Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titolo -->
        <Grid Grid.Row="0" Margin="16,14,16,4">
            <TextBlock Text="Quadro economico" Style="{DynamicResource ViewTitleStyle}" />
        </Grid>

        <!-- Toolbar: maggiorazione + IVA + Calcola -->
        <Border Grid.Row="1" Margin="16,8,16,0" Padding="12,10"
                Background="{DynamicResource PanelSubBrush}"
                BorderBrush="{DynamicResource EdgeLightBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource InkDefaultBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Magg. %" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,4,0" />
                    <TextBox Width="46" FontSize="11"
                             Text="{Binding MarkupPercent, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Maggiorazione SG+utile. Vuoto = nessuna maggiorazione." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="IVA %" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,4,0" />
                    <TextBox Width="46" FontSize="11"
                             Text="{Binding DefaultVatPercent, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="IVA di default. Vuoto = IVA non calcolata." />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="◌" Margin="12,0,12,0"
                           FontFamily="{DynamicResource FontMono}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center"
                           Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <Button Grid.Column="4" Content="Calcola"
                        Command="{Binding RunCommand}"
                        Padding="14,4" FontSize="11" FontWeight="SemiBold"
                        Background="{DynamicResource BrandAccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Contenuto -->
        <ScrollViewer Grid.Row="2" Margin="16,8,16,16" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasReport, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
            <StackPanel>

                <!-- Scala dei 4 livelli -->
                <Border Margin="0,0,0,12" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTALI (D.LGS. 36/2023)" Style="{DynamicResource SectionLabelStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Livello 1: costo diretto -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Costo diretto (Σ q × prezzo)"
                                       FontSize="12" Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DirectCostLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="0,3"
                                       Foreground="{DynamicResource InkDefaultBrush}" />

                            <!-- Maggiorazione -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Maggiorazione (SG + utile)"
                                       FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MarkupLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="0,3"
                                       Foreground="{DynamicResource InkMutedBrush}" />

                            <!-- Separatore -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Margin="0,4"
                                    Background="{DynamicResource EdgeLightBrush}" />

                            <!-- Livello 3: imponibile -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Imponibile"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaxableLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="SemiBold" Margin="0,3"
                                       Foreground="{DynamicResource InkDefaultBrush}" />

                            <!-- IVA -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="IVA"
                                       FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VatLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="0,3"
                                       Foreground="{DynamicResource InkMutedBrush}" />

                            <!-- Totale con IVA -->
                            <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0" Padding="8,6"
                                    Background="{DynamicResource BrandAccentSoftBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTALE (IVA inclusa)"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkDefaultBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GrandTotalLabel}"
                                               FontFamily="{DynamicResource FontDisplay}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource BrandAccentBrush}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CAM -->
                <Border Margin="0,0,0,12" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="CRITERI AMBIENTALI MINIMI (CAM)" Style="{DynamicResource SectionLabelStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Importo voci CAM" FontSize="12"
                                       Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CamImportoLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="0,3"
                                       Foreground="{DynamicResource InkDefaultBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quota CAM sul totale" FontSize="12"
                                       Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QuotaCamLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="SemiBold" Margin="0,3"
                                       Foreground="{DynamicResource BrandAccentBrush}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CamUnclassifiedLabel}"
                                       FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkMutedBrush}" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Manodopera -->
                <Border Margin="0,0,0,12" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="INCIDENZA MANODOPERA (ART. 41 D.LGS. 36/2023)" Style="{DynamicResource SectionLabelStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Incidenza manodopera" FontSize="12"
                                       Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ManodoperaImportoLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="0,3"
                                       Foreground="{DynamicResource InkDefaultBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Incidenza % sul totale lavori" FontSize="12"
                                       Foreground="{DynamicResource InkDefaultBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ManodoperaPercentLabel}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="SemiBold" Margin="0,3"
                                       Foreground="{DynamicResource BrandAccentBrush}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ManodoperaCoverageLabel}"
                                       FontSize="10" FontStyle="Italic" Foreground="{DynamicResource InkMutedBrush}" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Avvisi qualità dati -->
                <Border Style="{DynamicResource CardStyle}"
                        Visibility="{Binding HasWarnings, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="AVVISI" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource InkDefaultBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
