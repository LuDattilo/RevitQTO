<UserControl x:Class="QtoRevitPlugin.UI.Views.VerificaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QtoRevitPlugin.UI.ViewModels">
    <UserControl.DataContext>
        <vm:VerificaViewModel/>
    </UserControl.DataContext>

    <Grid Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titolo -->
        <Grid Grid.Row="0" Margin="16,14,16,4">
            <TextBlock Text="Verifica pre-consegna" Style="{DynamicResource ViewTitleStyle}" />
        </Grid>

        <!-- Toolbar: percentuali opzionali + Esegui -->
        <Border Grid.Row="1" Margin="16,8,16,0" Padding="12,10"
                Background="{DynamicResource PanelSubBrush}"
                BorderBrush="{DynamicResource EdgeLightBrush}" BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource InkDefaultBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Magg. %" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,4,0" />
                    <TextBox Width="46" FontSize="11"
                             Text="{Binding MarkupPercent, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Maggiorazione SG+utile (opzionale). Vuoto = non verificata." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="IVA %" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,4,0" />
                    <TextBox Width="46" FontSize="11"
                             Text="{Binding DefaultVatPercent, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="IVA di default (opzionale). Vuoto = non verificata." />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="◌" Margin="12,0,12,0"
                           FontFamily="{DynamicResource FontMono}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center"
                           Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <Button Grid.Column="4" Content="Esegui verifica"
                        Command="{Binding RunCommand}"
                        Padding="14,4" FontSize="11" FontWeight="SemiBold"
                        Background="{DynamicResource BrandAccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- KPI: errori / avvisi -->
        <Border Grid.Row="2" Margin="16,8,16,0" Padding="10,8"
                Background="{DynamicResource ChromeBgBrush}"
                BorderBrush="{DynamicResource ChromeEdgeBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding HasReport, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
            <UniformGrid Columns="2">
                <StackPanel>
                    <TextBlock Text="ERRORI" FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ChromeTextDimBrush}" />
                    <TextBlock Text="{Binding ErrorCount}" Margin="0,4,0,0"
                               FontFamily="{DynamicResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="AVVISI" FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ChromeTextDimBrush}" />
                    <TextBlock Text="{Binding WarningCount}" Margin="0,4,0,0"
                               FontFamily="{DynamicResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Contenuto -->
        <ScrollViewer Grid.Row="3" Margin="16,8,16,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty state -->
                <Border Padding="14"
                        Background="{DynamicResource BrandAccentSoftBrush}"
                        BorderBrush="{DynamicResource BrandAccentBrush}" BorderThickness="1" CornerRadius="4"
                        Visibility="{Binding HasNoIssues, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontFamily="{DynamicResource FontMono}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nessun rilievo. Il computo è pronto per la consegna."
                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource InkDefaultBrush}" />
                    </StackPanel>
                </Border>

                <!-- Stato delle classi di verifica -->
                <Border Margin="0,0,0,12" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="CLASSI DI VERIFICA" Style="{DynamicResource SectionLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Classes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Badge stato -->
                                        <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BrandAccentSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ChromeBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ESEGUITA" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                <Setter Property="Text" Value="N/A" />
                                                                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkDefaultBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Rilievi -->
                <Border Style="{DynamicResource CardStyle}"
                        Visibility="{Binding Findings.Count, Converter={x:Static vm:IntToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="RILIEVI" Style="{DynamicResource SectionLabelStyle}" />
                        <DataGrid ItemsSource="{Binding Findings}" Margin="0,6,0,0"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="24" FontSize="10" Background="White"
                                  BorderThickness="1" BorderBrush="{DynamicResource EdgeLightBrush}" IsReadOnly="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Background" Value="#FFF6EC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severità" Binding="{Binding SeverityLabel}" Width="70" />
                                <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="160" />
                                <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="140" />
                                <DataGridTextColumn Header="Voce" Binding="{Binding Voce}" Width="110" />
                                <DataGridTextColumn Header="Messaggio" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
