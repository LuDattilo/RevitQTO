<UserControl x:Class="QtoRevitPlugin.UI.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QtoRevitPlugin.UI.ViewModels">

    <!-- Pattern uniformato a Listino: titolo+popout in Row=Auto, contenuto scrollabile in Row=*,
         status bar in Row=Auto sempre visibile in basso. -->
    <Grid Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: titolo + popout -->
            <RowDefinition Height="*" />      <!-- 1: contenuto (ScrollViewer) -->
            <RowDefinition Height="Auto" />   <!-- 2: status bar -->
        </Grid.RowDefinitions>

        <!-- Titolo + bottone pop-out -->
        <Grid Grid.Row="0" Margin="16,14,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Selezione Elementi" Style="{DynamicResource ViewTitleStyle}" />
            <Button Grid.Column="2" x:Name="BtnPopout" Click="OnPopoutClick"
                    Content="⤢ Apri in finestra"
                    Style="{DynamicResource BtnTool}"
                    Foreground="{DynamicResource InkDimBrush}"
                    VerticalAlignment="Center"
                    ToolTip="Apre questa scheda in una finestra separata" />
        </Grid>

        <!-- Contenuto principale scrollabile (pattern uniformato a Listino). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- card filtri (con ScrollViewer annidato MaxHeight=360) -->
                <RowDefinition Height="Auto" />   <!-- toolbar isola/nascondi/reset -->
                <RowDefinition Height="Auto" />   <!-- DataGrid risultati -->
                <RowDefinition Height="Auto" />   <!-- card Assegna EP (Plan C-6) -->
            </Grid.RowDefinitions>

        <!-- Filtro: Fase Revit + Modalità computo + Categoria + Filtri parametrici -->
        <!-- ScrollViewer annidato con MaxHeight: se l'utente aggiunge molti filtri
             parametrici la card non schiaccia il DataGrid sottostante. -->
        <ScrollViewer Grid.Row="0" MaxHeight="360"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Style="{DynamicResource CardStyle}" Margin="16,8,16,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sezione 1 — FASE -->
                <TextBlock Grid.Row="0" Text="1 — FASE REVIT" Style="{DynamicResource SectionLabelStyle}" />

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Style="{DynamicResource CmbField}"
                              ItemsSource="{Binding AvailablePhases}"
                              SelectedItem="{Binding SelectedPhase, Mode=TwoWay}"
                              DisplayMemberPath="Name" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Modalità computo"
                                   Style="{DynamicResource SectionLabelStyle}" />
                        <ComboBox Margin="0,6,0,0"
                                  Style="{DynamicResource CmbField}"
                                  ItemsSource="{Binding ComputationModes}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding ComputationMode, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           Text="{Binding ActivePhaseName, StringFormat='La fase corrente aggiorna Selezione, Tagging, Preview e Struttura Computo · «{0}»'}"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource InkMutedBrush}"
                           TextWrapping="Wrap" />

                <!-- Separatore -->
                <Border Grid.Row="3" Height="1" Background="{DynamicResource EdgeLightBrush}" Margin="0,10,0,8"/>

                <!-- Sezione 2 — CATEGORIA -->
                <TextBlock Grid.Row="4" Text="2 — CATEGORIA" Style="{DynamicResource SectionLabelStyle}" />

                <!-- Categoria + ricerca -->
                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Categoria:" Margin="0,0,8,0"
                               VerticalAlignment="Center" FontSize="11" />
                    <ComboBox Grid.Column="1"
                              Style="{DynamicResource CmbField}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                    <TextBlock Grid.Column="2" Text="Cerca nome:" Margin="12,0,8,0"
                               VerticalAlignment="Center" FontSize="11" />
                    <TextBox Grid.Column="3"
                             Style="{DynamicResource TxtField}"
                             Text="{Binding NameQuery, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Separatore -->
                <Border Grid.Row="6" Height="1" Background="{DynamicResource EdgeLightBrush}" Margin="0,10,0,8"/>

                <!-- Sezione 3 — FILTRI PARAMETRICI -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="3 — FILTRI PARAMETRICI"
                               Style="{DynamicResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding AddParamRuleCommand}"
                            Content="+ Aggiungi filtro"
                            Style="{DynamicResource BtnTool}" />
                </Grid>

                <StackPanel Grid.Row="8">
                    <ItemsControl x:Name="ParamRulesList" ItemsSource="{Binding ParamRules}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <!-- AND/OR — nascosto per la prima regola -->
                                        <ColumnDefinition Width="46"/>
                                        <!-- Parametro (ComboBox con autocomplete) -->
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <!-- Operatore -->
                                        <ColumnDefinition Width="105"/>
                                        <!-- Valore -->
                                        <ColumnDefinition Width="*" MinWidth="70"/>
                                        <!-- × rimuovi -->
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- AND/OR pill — hidden for first rule via wrapper -->
                                    <Border Grid.Column="0" Margin="0,0,4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ComboBox Style="{DynamicResource CmbField}"
                                                  ItemsSource="{x:Static vm:ParamFilterRuleVm.LogicLabels}"
                                                  SelectedItem="{Binding LogicLabel, Mode=TwoWay}"
                                                  FontSize="10" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Parametro: ComboBox editabile (IsEditable=True) con lista da Revit -->
                                    <ComboBox Grid.Column="1"
                                              Style="{DynamicResource CmbField}"
                                              IsEditable="True"
                                              ItemsSource="{Binding AvailableParams}"
                                              Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Seleziona un parametro dalla lista o digita il nome esatto"/>

                                    <!-- Operatore -->
                                    <ComboBox Grid.Column="2" Margin="4,0"
                                              Style="{DynamicResource CmbField}"
                                              ItemsSource="{x:Static vm:ParamFilterRuleVm.OperatorLabels}"
                                              SelectedItem="{Binding OperatorLabel, Mode=TwoWay}" />

                                    <!-- Valore — nascosto per IsEmpty/IsNotEmpty via wrapper -->
                                    <Border Grid.Column="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsValue}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!--
                                            Valore: TextBox libera per operatori testuali/numerici,
                                            ComboBox editabile con valori distinti del modello quando
                                            l'operatore è '=' o '≠' (IsValueFromList).
                                            La ComboBox popola i valori lazy sul DropDownOpened.
                                        -->
                                        <Grid>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Valore in unità di progetto (lunghezze in m, aree in m²)">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TxtField}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValueFromList}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox IsEditable="True"
                                                      ItemsSource="{Binding AvailableValues}"
                                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownOpened="OnValueComboDropDownOpened"
                                                      ToolTip="Seleziona un valore presente nel modello o digita il valore esatto">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource CmbField}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValueFromList}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="4" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveParamRuleCommand,
                                                      Source={x:Reference ParamRulesList}}"
                                            CommandParameter="{Binding}"
                                            Content="×" Style="{DynamicResource BtnIcon}"
                                            ToolTip="Rimuovi filtro"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,5,0,0" FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasParamRules}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        &#x26A0; Valori numerici in unità di progetto (lunghezze in m, aree in m²). Testi case-insensitive. La lista parametri si popola selezionando una categoria.
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>
        </ScrollViewer>

        <!-- Toolbar azioni -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,4">
            <Button x:Name="BtnIsolate" Click="OnIsolateClick"
                    Content="Isola in vista"
                    Style="{DynamicResource BtnPrimary}"
                    Padding="10,5" FontSize="11" />
            <Button x:Name="BtnHide" Click="OnHideClick"
                    Content="Nascondi"
                    Style="{DynamicResource BtnTool}"
                    Margin="6,0,0,0" />
            <Button x:Name="BtnReset" Click="OnResetClick"
                    Content="Reset vista"
                    Style="{DynamicResource BtnTool}"
                    Margin="6,0,0,0" />
            <Button x:Name="BtnRefresh" Click="OnRefreshClick"
                    Content="Aggiorna"
                    Style="{DynamicResource BtnTool}"
                    Margin="6,0,0,0"
                    Foreground="{DynamicResource InkDimBrush}" />
        </StackPanel>

        <!-- DataGrid risultati -->
        <Border Grid.Row="2" Margin="16,0,16,8" MinHeight="300"
                BorderBrush="{DynamicResource EdgeLightBrush}" BorderThickness="1">
            <DataGrid x:Name="GridElements"
                      ItemsSource="{Binding Elements}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="22"
                      FontSize="11"
                      Background="White"
                      BorderThickness="0"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <EventSetter Event="MouseRightButtonUp" Handler="OnColumnHeaderRightClick"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"            Binding="{Binding ElementId}"           Width="70"  FontFamily="Consolas" />
                    <DataGridTextColumn Header="Famiglia"      Binding="{Binding FamilyName}"          Width="*" />
                    <DataGridTextColumn Header="Tipo"          Binding="{Binding TypeName}"            Width="*" />
                    <DataGridTextColumn Header="Livello"       Binding="{Binding LevelName}"           Width="80" />
                    <DataGridTextColumn Header="Fase creaz."   Binding="{Binding PhaseCreatedName}"    Width="100" FontSize="10" />
                    <DataGridTextColumn Header="Fase demol."   Binding="{Binding PhaseDemolishedName}" Width="100" FontSize="10" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Plan C-6: Card ASSEGNA EP (tra DataGrid risultati e status bar) -->
        <Border Grid.Row="3" Margin="16,4,16,4" Padding="10,8"
                Background="{DynamicResource PanelSubBrush}"
                BorderBrush="{DynamicResource EdgeLightBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Riga 1: voce attiva + descrizione -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="ASSEGNA VOCE EP"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveEpCode, StringFormat=' · {0}'}"
                               Margin="6,0,0,0" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource InkDefaultBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveEpDescription}"
                               Margin="8,0,0,0" FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>

                <!-- Riga 2: ComboBox QuantityMode (scelta unica compatta) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Quantità per istanza:" FontSize="10"
                               Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="180"
                              Style="{DynamicResource CmbField}"
                              ItemsSource="{Binding QuantityModeOptions}"
                              SelectedValuePath="Mode"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding QuantityMode, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Riga 3: preview + bottone applica -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AssignPreview}"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource BrandAccentDeepBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Assegna agli elementi filtrati"
                            Command="{Binding ApplyEpCommand}"
                            Style="{DynamicResource BtnPrimary}"
                            Padding="10,5" FontSize="11"/>
                </Grid>
            </Grid>
        </Border>

        </Grid>   <!-- chiude Grid interno 4 righe -->
        </ScrollViewer>

        <!-- Status bar fuori dal ScrollViewer (sempre visibile in basso) -->
        <Border Grid.Row="2" Background="{DynamicResource PanelSubBrush}"
                BorderBrush="{DynamicResource EdgeLightBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource InkMutedBrush}" />
        </Border>
    </Grid>
</UserControl>
